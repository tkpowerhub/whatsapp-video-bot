# Copy this file to ".env" and fill in your own values.
# NEVER share this file or commit it to git — it holds secrets.

# WhatsApp Cloud API access token (permanent token from Meta developer app)
WHATSAPP_TOKEN=

# WhatsApp Business phone number id (from Meta App > WhatsApp > API Setup)
PHONE_NUMBER_ID=

# Any secret string you choose — must match the verify token you type
# in Meta's webhook settings (e.g. a random 20+ character string)
VERIFY_TOKEN=

# Optional — Meta Graph API version (default v21.0)
# GRAPH_VERSION=v21.0

# Optional — port the server listens on (default 8000)
# PORT=8000

# Optional — working folder for downloaded/edited videos (default ./work)
# BOT_WORK_DIR=./work
